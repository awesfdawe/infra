app:
  path_prefix: "/"
  unix_socket_path: "/var/run/subscription-server/subscription-server.sock"
  mihomo_template_path: "/config/mihomo_template.yaml"
  trusted_ips: "*"
  response_headers:
    profile-update-interval: "3"
    profile-title: "Kolotushka VPN"
    announce: "base64:"

proxy_providers:
  self:
    type: "file"
    path: "/config/hysteria2.json"
{% if proxy_providers is defined and proxy_providers %}
{% for key, val in proxy_providers.items() %}
{% if key != 'self' %}

  {{ {key: val} | to_nice_yaml(indent=2, sort_keys=False) | indent(2) | trim }}
{% endif %}
{% endfor %}
{% endif %}
